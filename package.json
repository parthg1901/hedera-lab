{
  "name": "hedera-harness",
  "version": "1.2.2",
  "description": "Hedera Lab: independent application verification, agent repair, and budget-aware paid testing built on Hedera Harness.",
  "type": "module",
  "bin": {
    "hedera-harness": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills-index.json",
    "prompts",
    "skeletons",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "examples/lab-ticketing",
    "docs",
    "examples/verification",
    "examples/preflight",
    "examples/grant-flow",
    "examples/team-payouts",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "skills/hedera-lab"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "harness": "npm run build --silent && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "rm -rf .tmp-test",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "smoke:pack": "bash scripts/smoke-pack.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "check:templates": "bash scripts/check-template-recipes.sh",
    "test:browser": "npm run build --silent && node --test test/browser/*.test.mjs",
    "test:lab": "npm run build --silent && node --test test/lab*.test.mjs",
    "lab:demo": "npm run build --silent && node dist/index.js lab run examples/lab-ticketing/scenarios/purchase.yaml --workspace examples/lab-ticketing",
    "lab:agent": "npm run build --silent && node scripts/lab-agent-eval.mjs",
    "verify:demo": "npm run build --silent && node dist/index.js verify demo",
    "verify:serve": "npm run build --silent && node dist/index.js verify serve"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthg1901/hedera-lab.git"
  },
  "homepage": "https://github.com/parthg1901/hedera-lab#readme",
  "bugs": {
    "url": "https://github.com/parthg1901/hedera-lab/issues"
  },
  "keywords": [
    "hedera",
    "scaffold-hbar",
    "harness",
    "agentic",
    "cli"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@hiero-ledger/sdk": "^2.86.2",
    "playwright": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "@hiero-ledger/sdk": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.86.2",
    "@types/node": "^26.1.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hiero-ledger/proto": {
      "protobufjs": "8.8.0"
    },
    "@hiero-ledger/sdk": {
      "ethers": "6.17.0"
    },
    "ethers": {
      "ws": "8.21.3"
    }
  }
}
